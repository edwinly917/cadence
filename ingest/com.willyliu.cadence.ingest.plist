<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd 模板:每天 08:00 跑一次飞书摄入。
  安装:
    1. 先 `cd ingest && npm install && npm run build`
    2. 把下面的 <PATH-TO> 换成绝对路径(node 路径用 `which node` 查)
    3. cp 本文件到 ~/Library/LaunchAgents/
    4. launchctl load ~/Library/LaunchAgents/com.willyliu.cadence.ingest.plist
  卸载: launchctl unload ~/Library/LaunchAgents/com.willyliu.cadence.ingest.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.willyliu.cadence.ingest</string>

  <key>ProgramArguments</key>
  <array>
    <string>/PATH-TO/node</string>
    <string>/Users/bytedance/Desktop/cadence/ingest/dist/cli.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/bytedance/Desktop/cadence/ingest</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/bytedance/Desktop/cadence/ingest/state/ingest.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/bytedance/Desktop/cadence/ingest/state/ingest.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
