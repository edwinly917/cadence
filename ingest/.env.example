# --- Feishu / Lark 自建应用 ---
# 开放平台 > 应用 > 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 可选:user_access_token,用于覆盖用户个人私聊(tenant token 只能读 bot 所在的群+与 bot 的单聊)
FEISHU_USER_TOKEN=

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# 批量扫描默认用较省的型号;精度不足再换 claude-opus-4-8
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- 行为参数(都有默认值,可不填) ---
# 覆盖 cadence.db 路径(默认 macOS: ~/Library/Application Support/com.willyliu.cadence/cadence.db)
CADENCE_DB_PATH=
# 拉取窗口在上次水位基础上回溯的小时数(吸收时钟漂移/边界)
LOOKBACK_HOURS=26
# 首次运行(无水位)时回溯的天数,避免全量回溯爆炸
FIRST_RUN_LOOKBACK_DAYS=7
# 单次运行处理的消息硬上限
MAX_MESSAGES_PER_RUN=500
# 自动入象限的置信度阈值(0..1)
CONFIDENCE_THRESHOLD=0.75
# 是否要求"有 DDL"才能自动入象限(true=没 DDL 一律进待定)
REQUIRE_DDL_FOR_AUTOFILE=true
# 离线测试:指向一个 JSON 夹具文件代替真实飞书 API(见 README)
FEISHU_FIXTURE=

# ===== 每日摘要 + 指派任务录入(飞书 CLI 对接) =====
# 读取后端:larkcli=用 lark-cli 的用户 OAuth(推荐,自动续期、免把 bot 拉进群);api=遗留 tenant_access_token
READ_VIA=larkcli
LARK_CLI_BIN=lark-cli
# AI 后端:true=用本机 claude CLI(复用 Claude Code 订阅,无需 API key);false=用上面的 ANTHROPIC_API_KEY
USE_CLAUDE_CLI=true
CLAUDE_BIN=claude
# 可选:claude -p 的 --model 别名(留空=Claude Code 默认)
CLAUDE_CLI_MODEL=
# 任务1:要做每日情报摘要的群(逗号分隔)
DIGEST_CHAT_IDS=
# 任务2:扫描"指派给我"的任务的群(逗号分隔)
TASK_CHAT_IDS=
# 我的 open_id / 显示名(判定"指派给我");以及结果私信的接收 open_id
SELF_OPEN_ID=
SELF_NAME=
NOTIFY_OPEN_ID=
# 可选:群 chat_id -> 显示名(JSON,单行)
CHAT_LABELS=
